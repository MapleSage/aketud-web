---
import ElevateBase from '../layouts/ElevateBase.astro';
const modules = [
  { code: '01', title: 'Agency & distribution', text: 'Appointments, agency relationships, commissions, workflow, and the day-to-day work of distribution teams.' },
  { code: '02', title: 'Quote to policy', text: 'Submission, underwriting, rating, binding, issuance, documents, and policy servicing connected in one operating flow.' },
  { code: '03', title: 'Claims & FNOL', text: 'Intake, evidence, triage, and claim routing with the policy and customer context already attached.' },
  { code: '04', title: 'Premium & control', text: 'Premium state, accounting awareness, exceptions, and operational follow-through without a separate reconciliation universe.' },
];
const roles = [
  ['Agents', 'Move from customer conversation to quote, bind, policy, document, and service without leaving the operating record.'],
  ['Brokers', 'Give placement, policy, endorsement, document, and customer work a shared, visible home.'],
  ['MGAs', 'Run underwriting, product, delegated authority, agency, and operations work across the book.'],
  ['Agency teams', 'Coordinate service, policy change, claims visibility, tasks, and customer context in the same system.'],
];
---
<ElevateBase title="Insurance Command Center — AKETUD" description="End-to-end insurance platform and agency management for agents, brokers, MGAs, and agencies." transparentHeader navActive="Platform">
  <section class="app-hero">
    <div class="app-hero__glow"></div>
    <div class="app-wrap app-hero__inner">
      <div class="app-hero__copy">
        <p class="app-kicker">AKETUD / Insurance Command Center</p>
        <p class="app-brandline">AI You Can Accept</p>
        <h1>The operating center for the insurance business you actually run.</h1>
        <p class="app-lead">A connected platform and agency-management system for agents, brokers, MGAs, and agency teams—across quote, policy, claims, premium, distribution, and the work between them.</p>
        <div class="app-actions"><a href="/contact?system=platform" class="app-button app-button--solid">Request a live walkthrough <span>↗</span></a><a href="#modules" class="app-button app-button--line">Explore the command center <span>↓</span></a></div>
      </div>
      <div class="app-console" aria-label="Insurance Command Center feature map">
        <div class="app-console__top"><span>Insurance Command Center</span><span class="app-console__status"><i></i> Operating view</span></div>
        <div class="app-console__body">
          <div class="app-console__rail"><span class="is-active">Overview</span><span>Quotes</span><span>Policies</span><span>Claims</span><span>Agency</span><span>Reports</span></div>
          <div class="app-console__main">
            <p>Operating flow</p>
            <div class="app-console__flow"><b>Intake</b><i></i><b>Risk</b><i></i><b>Policy</b><i></i><b>Service</b></div>
            <div class="app-console__cards"><div><span>Distribution</span><strong>Agency & broker work</strong></div><div><span>Operating record</span><strong>Policy, evidence & premium</strong></div><div><span>Claims readiness</span><strong>Context stays attached</strong></div></div>
          </div>
        </div>
        <div class="app-console__foot">One connected operating record <span>AKETUD</span></div>
      </div>
    </div>
  </section>

  <section class="app-intro"><div class="app-wrap app-intro__grid"><p class="app-kicker app-kicker--dark">Not another dashboard</p><div><h2>Where the insurance operation comes together.</h2><p>Insurance Command Center is not a reporting layer over fragmented tools. It is the working surface where insurance teams see the state of the business, move work forward, and retain the context required to explain every change.</p></div></div></section>

  <section class="app-modules" id="modules"><div class="app-wrap"><div class="app-section-head"><p class="app-kicker app-kicker--dark">What runs through it</p><h2>The work is different. The operating record is shared.</h2></div><div class="app-module-grid">{modules.map((module) => <article><span>{module.code}</span><h3>{module.title}</h3><p>{module.text}</p></article>)}</div></div></section>

  <section class="app-roles"><div class="app-wrap"><div class="app-roles__head"><p class="app-kicker">Built for the teams around the policy</p><h2>From the first conversation to the next operational action.</h2></div><div class="app-role-grid">{roles.map(([role, text]) => <div><h3>{role}</h3><p>{text}</p></div>)}</div></div></section>

  <section class="app-connect"><div class="app-wrap app-connect__grid"><div><p class="app-kicker app-kicker--dark">The AKETUD system family</p><h2>Command Center connects to the systems that make the work specific.</h2></div><div class="app-connect__links"><a href="https://pas.aketud.com"><span>PAS</span><b>Policy administration</b><i>↗</i></a><a href="https://uw.aketud.com"><span>UW</span><b>Underwriting</b><i>↗</i></a><a href="https://fnol.aketud.com"><span>FNOL</span><b>First notice of loss</b><i>↗</i></a><a href="https://atlas.aketud.com"><span>Atlas</span><b>Entity intelligence</b><i>↗</i></a><a href="https://social.aketud.com"><span>Social</span><b>Social product system</b><i>↗</i></a></div></div></section>

  <section class="app-cta"><div class="app-wrap"><p class="app-kicker">See it on your operating terms</p><h2>Bring the product, agency, claims, or distribution workflow you need to run.</h2><a href="/contact?system=platform" class="app-button app-button--solid">Talk to AKETUD <span>↗</span></a></div></section>
</ElevateBase>

<style>
  /* app.aketud.com: functional, product-first, dark teal command-center language. */
  .app-wrap { max-width:1296px; margin:0 auto; padding-inline:32px; }.app-hero { position:relative; overflow:hidden; min-height:820px; background:linear-gradient(145deg,#052f3a,#03252f 72%); color:#fff; }.app-hero::before { content:""; position:absolute; inset:0; opacity:.4; background-image:linear-gradient(rgba(169,215,231,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(169,215,231,.07) 1px,transparent 1px); background-size:48px 48px; mask-image:linear-gradient(110deg,#000,transparent 78%); }.app-hero__glow { position:absolute; width:680px; height:680px; right:-260px; top:-180px; background:radial-gradient(circle,rgba(31,132,145,.32),transparent 70%); }.app-hero__inner { position:relative; display:grid; grid-template-columns:.9fr 1.1fr; min-height:820px; gap:70px; align-items:center; }.app-kicker,.app-brandline { margin:0; font:700 11px/1.3 system-ui,sans-serif; letter-spacing:.15em; text-transform:uppercase; }.app-kicker { color:#8ed6ea; }.app-kicker--dark { color:#0d7594; }.app-brandline { margin-top:33px; color:rgba(235,249,251,.58); }.app-hero h1 { max-width:11ch; margin:14px 0 22px; font:500 clamp(48px,6vw,90px)/.91 system-ui,sans-serif; letter-spacing:-.075em; }.app-lead { max-width:52ch; color:rgba(235,249,251,.75); font-size:18px; line-height:1.58; }.app-actions { display:flex; flex-wrap:wrap; gap:18px; margin-top:35px; }.app-button { display:inline-flex; align-items:center; gap:12px; padding:16px 18px; font:800 11px/1 system-ui,sans-serif; letter-spacing:.1em; text-decoration:none; text-transform:uppercase; transition:transform .18s ease; }.app-button:hover { transform:translateY(-2px); }.app-button--solid { background:#fff; color:#052f3a; }.app-button--line { padding-inline:0; color:#fff; border-bottom:1px solid rgba(255,255,255,.52); }.app-console { overflow:hidden; border:1px solid rgba(169,215,231,.35); border-radius:14px; background:rgba(3,35,46,.83); box-shadow:0 35px 90px rgba(0,0,0,.38); }.app-console__top,.app-console__foot { display:flex; justify-content:space-between; padding:16px 18px; color:rgba(235,249,251,.72); font:700 10px/1 system-ui,sans-serif; letter-spacing:.11em; text-transform:uppercase; }.app-console__top { border-bottom:1px solid rgba(169,215,231,.17); }.app-console__status { color:#8ed6ea; }.app-console__status i { display:inline-block; width:6px; height:6px; margin-right:6px; border-radius:50%; background:#8ed6ea; }.app-console__body { display:grid; grid-template-columns:135px 1fr; min-height:340px; }.app-console__rail { display:flex; flex-direction:column; gap:10px; padding:22px 13px; border-right:1px solid rgba(169,215,231,.17); }.app-console__rail span { padding:10px 8px; color:rgba(235,249,251,.5); font-size:12px; }.app-console__rail .is-active { background:rgba(142,214,234,.12); color:#fff; }.app-console__main { padding:31px 28px; }.app-console__main>p { margin:0 0 25px; color:#8ed6ea; font:700 10px/1 system-ui,sans-serif; letter-spacing:.13em; text-transform:uppercase; }.app-console__flow { display:flex; align-items:center; gap:8px; color:#fff; font-size:13px; }.app-console__flow i { width:20px; height:1px; background:#8ed6ea; }.app-console__cards { display:grid; gap:10px; margin-top:38px; }.app-console__cards div { padding:14px; border:1px solid rgba(169,215,231,.18); background:rgba(142,214,234,.045); }.app-console__cards span { display:block; color:#8ed6ea; font:700 9px/1 system-ui,sans-serif; letter-spacing:.1em; text-transform:uppercase; }.app-console__cards strong { display:block; margin-top:7px; color:rgba(255,255,255,.78); font-size:13px; }.app-console__foot { border-top:1px solid rgba(169,215,231,.17); }.app-console__foot span { color:#8ed6ea; }.app-intro,.app-modules,.app-connect { padding:110px 0; background:#fff; }.app-intro__grid,.app-connect__grid { display:grid; grid-template-columns:.7fr 1.3fr; gap:100px; }.app-intro h2,.app-section-head h2,.app-roles h2,.app-connect h2,.app-cta h2 { margin:0; color:#062b43; font:500 clamp(38px,5vw,66px)/.96 system-ui,sans-serif; letter-spacing:-.065em; }.app-intro p:last-child { max-width:52ch; margin:20px 0 0; color:#557182; font-size:18px; line-height:1.6; }.app-modules { background:#edf6fa; }.app-section-head { display:grid; grid-template-columns:.85fr 1.15fr; gap:55px; margin-bottom:54px; }.app-section-head h2 { max-width:18ch; }.app-module-grid { display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid rgba(6,43,67,.16); }.app-module-grid article { min-height:305px; padding:26px 24px; border-right:1px solid rgba(6,43,67,.16); border-bottom:1px solid rgba(6,43,67,.16); }.app-module-grid article:first-child { padding-left:0; }.app-module-grid article:last-child { border-right:0; }.app-module-grid span { color:#0d7594; font:700 10px/1 system-ui,sans-serif; letter-spacing:.12em; }.app-module-grid h3 { margin:42px 0 13px; color:#062b43; font-size:24px; line-height:1.05; letter-spacing:-.045em; }.app-module-grid p { color:#587283; font-size:15px; line-height:1.58; }.app-roles { padding:110px 0; background:linear-gradient(145deg,#052f3a,#03252f); color:#fff; }.app-roles h2 { max-width:18ch; margin-top:18px; color:#fff; }.app-roles__head { max-width:700px; }.app-role-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:15px; margin-top:55px; }.app-role-grid div { padding:25px 20px; border-top:1px solid rgba(169,215,231,.28); }.app-role-grid h3 { margin:0 0 12px; font-size:24px; letter-spacing:-.04em; }.app-role-grid p { margin:0; color:rgba(235,249,251,.68); font-size:15px; line-height:1.57; }.app-connect__links { border-top:1px solid rgba(6,43,67,.15); }.app-connect__links a { display:grid; grid-template-columns:75px 1fr auto; gap:14px; padding:19px 0; border-bottom:1px solid rgba(6,43,67,.15); color:#062b43; text-decoration:none; }.app-connect__links span { color:#0d7594; font:700 10px/1 system-ui,sans-serif; letter-spacing:.12em; align-self:center; }.app-connect__links b { font-size:19px; letter-spacing:-.03em; }.app-connect__links i { color:#0d7594; font-style:normal; }.app-cta { padding:110px 0; background:#062b43; color:#fff; }.app-cta h2 { max-width:18ch; margin:18px 0 32px; color:#fff; }@media(max-width:900px){.app-hero__inner,.app-intro__grid,.app-connect__grid,.app-section-head{grid-template-columns:1fr;gap:32px}.app-hero__inner{padding-block:135px 75px}.app-console{max-width:650px}.app-module-grid,.app-role-grid{grid-template-columns:repeat(2,1fr)}.app-module-grid article:first-child{padding-left:24px}.app-module-grid article:nth-child(2n+1){padding-left:0}.app-module-grid article:nth-child(2n){border-right:0}}@media(max-width:620px){.app-wrap{padding-inline:20px}.app-hero{min-height:0}.app-hero__inner{padding-top:120px}.app-console__body{grid-template-columns:90px 1fr}.app-console__main{padding:24px 16px}.app-console__rail{padding:16px 8px}.app-console__flow{font-size:11px;gap:4px}.app-console__flow i{width:9px}.app-intro,.app-modules,.app-roles,.app-connect,.app-cta{padding:72px 0}.app-module-grid,.app-role-grid{grid-template-columns:1fr}.app-module-grid article,.app-module-grid article:nth-child(n){min-height:0;padding:24px 0;border-right:0}.app-role-grid{gap:0}.app-role-grid div{padding-inline:0}.app-hero h1{font-size:clamp(48px,15vw,76px)}}
</style>
