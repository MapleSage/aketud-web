---
import Base from '../layouts/Base.astro';
import Grain from '../components/Grain.astro';
import ScreenSlot from '../components/ScreenSlot.astro';
import { products } from '../lib/site';

export async function getStaticPaths() {
  return (await products()).map((p) => ({ params: { product: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const title = `${p.name} — ${p.eyebrow.split('— ')[1]} · AKETUD`;
const walkthrough = `/contact?system=${p.slug}`;
const dark = p.dark || !!p.heroVideo;
---
<Base title={title} description={p.lead} navActive="Platform">
  <!-- HERO -->
  <section class:list={['hero', { 'hero--dark': dark, 'hero--media': !!p.heroVideo }]}>
    {p.heroVideo && (
      <div class="hero__media" aria-hidden="true">
        <video autoplay muted loop playsinline preload="metadata" poster={`/cdn/hero/${p.heroVideo}.jpg`}>
          <source src={`/cdn/hero/${p.heroVideo}.webm`} type="video/webm" />
          <source src={`/cdn/hero/${p.heroVideo}.mp4`} type="video/mp4" />
        </video>
        <div class="hero__scrim"></div>
      </div>
    )}
    {dark && <Grain />}
    <div class="wrap hero__inner">
      <div class="eyebrow hero__brandline">AKETUD / AI YOU CAN ACCEPT</div>
      <div class="eyebrow hero__eyebrow">{p.eyebrow}</div>
      <h1 class="disp hero__name">{p.name}</h1>
      <p class="hero__lead">{p.lead}</p>
      <div class="hero__meta">
        <span class="eyebrow">{p.sector}</span>
        <span class="hero__domain">{p.domain}</span>
      </div>
      <div class="hero__cta">
        <a class="btn btn--solid" href={walkthrough}>Request a live walkthrough</a>
        <a class:list={['btn', dark ? 'btn--ghost-dark' : 'btn--ghost-light']} href="/contact">Book a call</a>
      </div>
    </div>
  </section>

  <!-- SCREENS -->
  <section class="section section--deep">
    <div class="wrap">
      <div class="head">
        <h2 class="disp">The product</h2>
        <span class="eyebrow">Captured from the running system</span>
      </div>
      <div class="shots">
        {p.screens.map((s) => <ScreenSlot screen={s} />)}
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE -->
  <section class="section section--paper">
    <div class="wrap grid12">
      <div class="arch__label">
        <div class="eyebrow" style="color: var(--accent)">How it's built</div>
      </div>
      <div class="arch__body">
        {p.architecture.map((para) => <p class="read">{para}</p>)}
        <div class="stack">
          {p.stack.map((s) => <span class="chip">{s}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--ink cta">
    <div class="wrap">
      <div class="eyebrow">On request, not on a schedule</div>
      <p class="disp cta__line">The cluster behind {p.name} comes up when someone asks to see it. Ask.</p>
      <div class="hero__cta">
        <a class="btn btn--solid" href={walkthrough}>Request a live walkthrough</a>
        <a class="btn btn--ghost-dark" href="/">See the rest of the systems</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; background: var(--paper); overflow: hidden;
    padding-block: clamp(72px, 12vw, 150px); }
  .hero--dark { background: var(--ink-black); color: var(--paper); }
  .hero--media { padding-block: clamp(96px, 16vw, 190px); }
  .hero__media { position: absolute; inset: 0; z-index: 0; }
  .hero__media video { width: 100%; height: 100%; object-fit: cover; }
  .hero__scrim { position: absolute; inset: 0;
    background:
      radial-gradient(80% 60% at 82% 10%, rgba(196,83,31,0.22) 0%, rgba(12,11,10,0) 60%),
      linear-gradient(180deg, rgba(12,11,10,0.55) 0%, rgba(12,11,10,0.42) 40%, rgba(12,11,10,0.82) 100%); }
  .hero__inner { position: relative; z-index: 2; max-width: 1100px; }
  .hero__eyebrow { color: var(--accent); }
  .hero__brandline { margin-bottom: 16px; color: #8ED6EA; }
  .hero--dark .hero__eyebrow { color: var(--accent-lit); }
  .hero__name {
    font-size: clamp(3.6rem, 11vw, 9rem); line-height: 0.9;
    letter-spacing: -0.035em; margin: 26px 0 0;
  }
  .hero__lead {
    font-family: var(--disp); font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    line-height: 1.3; letter-spacing: -0.015em; max-width: 900px;
    margin: 30px 0 0; color: inherit;
  }
  .hero--dark .hero__lead { color: rgba(245, 242, 237, 0.9); }
  .hero__meta {
    display: flex; gap: 28px; align-items: baseline; margin-top: 34px;
    padding-top: 22px; border-top: 1px solid var(--rule);
  }
  .hero--dark .hero__meta { border-color: var(--rule-dark); }
  .hero__domain { font-size: 13.5px; letter-spacing: 0.06em; color: var(--accent); }
  .hero--dark .hero__domain { color: var(--accent-lit); }
  .hero__cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 34px; }

  .head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 24px;
    border-bottom: 1px solid var(--rule); padding-bottom: 18px; margin-bottom: 44px;
    flex-wrap: wrap;
  }
  .head .disp { font-size: clamp(1.8rem, 3.4vw, 2.5rem); letter-spacing: -0.02em; margin: 0; }
  .head .eyebrow { color: rgba(20, 16, 13, 0.5); }
  .shots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }

  .arch__label { grid-column: 1 / 4; min-width: 0; }
  .arch__body { grid-column: 4 / -1; min-width: 0; display: flex; flex-direction: column; gap: 26px; }
  .arch__body .read { margin: 0; max-width: 760px; }
  .stack { display: flex; gap: 9px; flex-wrap: wrap; margin-top: 12px; }

  .cta__line {
    font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.14; letter-spacing: -0.02em;
    max-width: 860px; margin: 22px 0 34px;
  }

  @media (max-width: 900px) {
    .shots { grid-template-columns: 1fr; }
    .arch__label, .arch__body { grid-column: 1 / -1; grid-column-start: auto; }
  }
</style>
