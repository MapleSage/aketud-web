---
/* Platform, PAS, UW, FNOL, Atlas — rebuilt on AketudProductStory to match
   the visual system the Services pages (AketudServiceStory) already use.
   Was the old dark-editorial Base.astro/Grain/ScreenSlot template — real
   content (architecture, stack, screens) carried over unchanged. */
import AketudProductStory from '../components/AketudProductStory.astro';
import { products } from '../lib/site';

export async function getStaticPaths() {
  return (await products()).map((p) => ({ params: { product: p.slug }, props: { p } }));
}

const { p } = Astro.props;
---
<AketudProductStory p={p} />
