---
import ElevateBase from '../layouts/ElevateBase.astro';
const notes = [
  { no: '01', topic: 'Operating record', title: 'The policy record is not a document store.', body: 'A policy changes through time. The system needs to preserve what became true, what was believed true at the time, and why a correction happened.' },
  { no: '02', topic: 'Insurance AI', title: 'Evidence is the boundary for useful AI.', body: 'Insurance AI becomes useful when an answer can stay connected to the file, document, rule, or operational event that supports it.' },
  { no: '03', topic: 'Modernization', title: 'Migration is an operating decision, not a data-transfer project.', body: 'A modernized system should make the next release, claim, policy correction, and reconciliation easier—not simply move yesterday’s complexity to a new runtime.' },
];
---
<ElevateBase title="Insights — AKETUD" description="Operating notes on platform, AI, and insurance technology." navActive="Insights">
  <section class="ins-hero"><div class="ins-wrap"><p class="ins-tag">AKETUD Insights</p><h1>Notes from the insurance operating field.</h1><p>Short positions on the systems beneath underwriting, policy, claims, premium, and the decisions that have to remain explainable.</p></div></section>
  <section class="ins-list"><div class="ins-wrap ins-list__grid">{notes.map((note) => <article><span>{note.no} / {note.topic}</span><h2>{note.title}</h2><p>{note.body}</p><a href="/contact">Discuss this with AKETUD <b>↗</b></a></article>)}</div></section>
</ElevateBase>
<style>
  .ins-wrap { max-width:1120px; margin:0 auto; padding-inline:32px; }.ins-hero { padding:150px 0 105px; background:#edf6fa; }.ins-tag { color:#0d7594; font:700 11px/1 system-ui,sans-serif; letter-spacing:.14em; text-transform:uppercase; }.ins-hero h1 { max-width:12ch; margin:18px 0; color:#062b43; font:500 clamp(50px,8vw,100px)/.9 system-ui,sans-serif; letter-spacing:-.07em; }.ins-hero p:last-child { max-width:58ch; color:#557182; font-size:18px; line-height:1.6; }.ins-list { padding:100px 0; background:#fff; }.ins-list__grid { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid rgba(6,43,67,.16); }.ins-list article { min-height:330px; padding:25px 28px; border-right:1px solid rgba(6,43,67,.16); border-bottom:1px solid rgba(6,43,67,.16); }.ins-list article:first-child { padding-left:0; }.ins-list article:last-child { border-right:0; }.ins-list span { color:#0d7594; font:700 10px/1 system-ui,sans-serif; letter-spacing:.12em; text-transform:uppercase; }.ins-list h2 { margin:42px 0 14px; color:#062b43; font-size:28px; line-height:1.04; letter-spacing:-.05em; }.ins-list p { color:#557182; font-size:15px; line-height:1.58; }.ins-list a { display:inline-block; margin-top:20px; color:#062b43; font:800 10px/1 system-ui,sans-serif; letter-spacing:.09em; text-decoration:none; text-transform:uppercase; }.ins-list b { color:#0d7594; }@media(max-width:760px){.ins-wrap{padding-inline:20px}.ins-hero,.ins-list{padding:75px 0}.ins-list__grid{grid-template-columns:1fr}.ins-list article,.ins-list article:first-child{min-height:0;padding:26px 0;border-right:0}.ins-list h2{margin-top:25px}}
</style>
