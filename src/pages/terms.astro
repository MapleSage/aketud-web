---
import ElevateBase from '../layouts/ElevateBase.astro';
---
<ElevateBase title="Terms — AKETUD" description="Terms for aketud.com." navActive="AKETUD">
  <section class="eh-legal">
    <div class="hs-elevate-content-wrapper hs-elevate-content-wrapper--md">
      <p class="hs-elevate-tag">Terms</p>
      <h1 class="hs-elevate-h2">Terms</h1>
      <p>For the current Terms, contact <a href="mailto:hello@aketud.com">hello@aketud.com</a>. This page is a placeholder pending the finalised text.</p>
    </div>
  </section>
</ElevateBase>

<style>
  .eh-legal { padding-block: var(--hsElevate--section--medium__verticalPadding); }
  .eh-legal h1 { margin: 10px 0 20px; }
  .eh-legal p { font-size: 16px; line-height: 1.75; color: var(--hsElevate--body__fontColor, #4a5a72); }
</style>
