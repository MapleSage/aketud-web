---
/* Hero — direction B (Swiss paper). Artboard 03.
   Archivo Black at scale, hard 1.5px rules, five-product rail down the right,
   no imagery. Copy from pages/home.json. */
import { page, products } from '../lib/site';
const h = (await page('home')).heroB!;
const rail = (await products()).slice(0, 5);
const titleHtml = h.title.split('\n')
  .map((l) => l.replace(/\*([^*]+)\*/g, '<span style="color:var(--accent)">$1</span>'))
  .join('<br />');
---
<section class="heroB">
  <div class="heroB__left">
    <span class="eyebrow heroB__kick">{h.eyebrow}</span>
    <h1 class="heroB__title" set:html={titleHtml}></h1>
    <div class="heroB__foot">
      <p class="heroB__lead">{h.lead}</p>
      <a class="heroB__cta" data-hero-cta href={h.cta.href}>{h.cta.label}</a>
    </div>
  </div>
  <div class="heroB__rail">
    {rail.map((p, i) => (
      <a class:list={['heroB__cell', { last: i === rail.length - 1 }]} href={`/${p.slug}`}>
        <span class="eyebrow heroB__no">{p.no} {p.eyebrow.split('— ')[1]}</span>
        <span class="heroB__name">{p.name}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .heroB {
    background: var(--paper); color: var(--ink);
    display: grid; grid-template-columns: 2fr 1fr;
    border-bottom: 1.5px solid var(--ink);
    min-height: 82vh;
  }
  .heroB__left {
    border-right: 1.5px solid var(--ink);
    padding: 56px var(--gutter);
    display: flex; flex-direction: column; justify-content: space-between; gap: 40px;
  }
  .heroB__kick { color: var(--accent); font-weight: 700; }
  .heroB__title {
    font-family: "Archivo Variable", Archivo, sans-serif; font-weight: 700;
    font-size: clamp(3.2rem, 10vw, 8.5rem); line-height: 0.84;
    letter-spacing: -0.055em; text-transform: uppercase; margin: 0;
  }
  .heroB__title .ac { color: var(--accent); }
  .heroB__foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
  .heroB__lead { font-size: 18px; line-height: 1.55; max-width: 440px; font-weight: 500; margin: 0; }
  .heroB__cta {
    background: var(--ink); color: var(--paper); padding: 17px 32px;
    font-size: 13.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
  }
  .heroB__cta:hover { background: var(--accent); color: var(--paper); }

  .heroB__rail { display: flex; flex-direction: column; }
  .heroB__cell {
    flex: 1; border-bottom: 1.5px solid var(--ink);
    padding: 26px 30px; display: flex; flex-direction: column; justify-content: center; gap: 8px;
    color: var(--ink);
  }
  .heroB__cell.last { border-bottom: 0; background: var(--ink); color: var(--paper); }
  .heroB__cell:hover { background: var(--accent); color: var(--paper); }
  .heroB__cell.last:hover { background: var(--accent); }
  .heroB__no { color: rgba(20, 16, 13, 0.45); font-size: 10.5px; }
  .heroB__cell.last .heroB__no, .heroB__cell:hover .heroB__no { color: inherit; opacity: 0.7; }
  .heroB__name { font-size: clamp(1.6rem, 2.4vw, 2rem); font-weight: 700; letter-spacing: -0.03em; font-family: "Archivo Variable", Archivo, sans-serif; }

  @media (max-width: 900px) {
    .heroB { grid-template-columns: 1fr; }
    .heroB__left { border-right: 0; border-bottom: 1.5px solid var(--ink); }
  }
</style>
