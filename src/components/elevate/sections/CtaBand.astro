---
/* Full-bleed conversion band — heading + one or two buttons. */
interface Cta { label: string; href: string }
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  ctaPrimary: Cta;
  ctaSecondary?: Cta;
  tone?: 'accent' | 'dark' | 'light';
}
const { eyebrow, heading, body, ctaPrimary, ctaSecondary, tone = 'dark' } = Astro.props;
---
<section class:list={['eh-ctaband', `eh-ctaband--${tone}`]}>
  <div class="hs-elevate-content-wrapper eh-ctaband__inner">
    <div class="eh-ctaband__copy">
      {eyebrow && <p class="hs-elevate-tag">{eyebrow}</p>}
      <h2 class="hs-elevate-h2">{heading}</h2>
      {body && <p class="eh-ctaband__body">{body}</p>}
    </div>
    <div class="eh-ctaband__ctas">
      <a class="hs-elevate-button hs-elevate-button--primary" href={ctaPrimary.href}>{ctaPrimary.label}</a>
      {ctaSecondary && <a class="hs-elevate-button hs-elevate-button--secondary" href={ctaSecondary.href}>{ctaSecondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .eh-ctaband { padding-block: var(--hsElevate--section--medium__verticalPadding); }
  .eh-ctaband--dark { background: var(--hsElevate--color--base--3); color: var(--hsElevate--color--base--1); }
  .eh-ctaband--light { background: var(--hsElevate--color--base--2); }

  /* "accent" = solid brand-colour band. The button system's own colours
     (orange fill / orange outline) are meant to sit on white or dark-navy —
     on an orange band they'd blend straight into the background, so this
     tone gets its own white-on-orange button treatment. */
  .eh-ctaband--accent { background: var(--hsElevate--color--accent--3); color: #fff; }
  .eh-ctaband--accent .hs-elevate-button--primary {
    background: #fff; color: var(--hsElevate--color--accent--3);
  }
  .eh-ctaband--accent .hs-elevate-button--primary:hover { background: var(--hsElevate--color--base--2); }
  .eh-ctaband--accent .hs-elevate-button--secondary {
    background: transparent; color: #fff; border-color: rgba(255,255,255,0.8);
  }
  .eh-ctaband--accent .hs-elevate-button--secondary:hover { background: rgba(255,255,255,0.14); }
  .eh-ctaband__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 40px; flex-wrap: wrap;
  }
  .eh-ctaband__copy { max-width: 640px; }
  .eh-ctaband__copy h2 { margin: 8px 0 0; color: inherit; }
  .eh-ctaband__body { margin: 14px 0 0; opacity: .85; }
  .eh-ctaband__ctas { display: flex; gap: 14px; flex-wrap: wrap; flex-shrink: 0; }
</style>
