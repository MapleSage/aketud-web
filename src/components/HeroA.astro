---
/* Hero — direction A (dark editorial). Artboard 01/02.
   Media slot behind: silent looped video with the still as poster/fallback.
   Grain + grid overlay stay on top of the media. Copy from pages/home.json. */
import { page } from '../lib/site';
const h = (await page('home')).heroA!;
const titleLines = h.title.split('\n').map((l) =>
  l.replace(/\*([^*]+)\*/g, '<span style="font-style:italic;color:var(--accent-lit)">$1</span>')
);
---
<section class="heroA">
  <div class="heroA__media" aria-hidden="true">
    <video
      class="heroA__video"
      autoplay muted loop playsinline preload="metadata"
      poster="/cdn/hero/hero-a-v3.jpg"
    >
      <source src="/cdn/hero/hero-a-v3.webm" type="video/webm" />
      <source src="/cdn/hero/hero-a-v3.mp4" type="video/mp4" />
    </video>
    <div class="heroA__wash"></div>
  </div>

  <div class="grain" aria-hidden="true"></div>
  <div class="scan" aria-hidden="true"></div>
  <div class="grid" aria-hidden="true">{Array.from({ length: 12 }).map(() => <span></span>)}</div>

  <div class="wrap heroA__inner">
    <div class="eyebrow heroA__eyebrow">{h.eyebrow}</div>
    <h1 class="disp heroA__title" set:html={titleLines.join('<br />')}></h1>
    <div class="heroA__row">
      <span class="eyebrow heroA__sub">{h.sub}</span>
      <div class="heroA__cta">
        <a class="btn btn--solid" data-hero-cta href={h.ctaPrimary.href}>{h.ctaPrimary.label}</a>
        <a class="btn btn--ghost-dark" href={h.ctaSecondary.href}>{h.ctaSecondary.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .heroA {
    position: relative; background: var(--ink-black); color: var(--paper);
    min-height: 100vh; min-height: 100svh; display: flex; align-items: flex-end;
    overflow: hidden;
  }
  .heroA__media { position: absolute; inset: 0; }
  .heroA__video { width: 100%; height: 100%; object-fit: cover; }
  .heroA__wash {
    position: absolute; inset: 0;
    background:
      radial-gradient(90% 70% at 82% 12%, rgba(196,83,31,0.30) 0%, rgba(196,83,31,0.04) 40%, rgba(12,11,10,0) 66%),
      linear-gradient(180deg, rgba(10,12,16,0.30) 0%, rgba(10,12,16,0.12) 38%, rgba(12,11,10,0.55) 78%, rgba(12,11,10,0.86) 100%);
  }
  .grain, .scan, .grid { position: absolute; inset: 0; pointer-events: none; }
  .grain {
    opacity: 0.30; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='240' height='240' filter='url(%23n)'/></svg>");
  }
  .scan { background-image: linear-gradient(rgba(245,242,237,0.055) 1px, transparent 1px); background-size: 100% 4px; }
  .grid { left: var(--gutter); right: var(--gutter); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .grid span { border-left: 1px solid rgba(245,242,237,0.055); }
  .grid span:last-child { border-right: 1px solid rgba(245,242,237,0.055); }

  .heroA__inner { position: relative; z-index: 3; width: 100%; padding-block: 120px 84px; }
  .heroA__eyebrow { color: rgba(245, 242, 237, 0.55); }
  .heroA__title {
    font-size: clamp(3.6rem, 13vw, 10.5rem); line-height: 0.86;
    letter-spacing: -0.035em; margin: 30px 0 0; text-wrap: balance;
  }
  .heroA__title .i { font-style: italic; color: var(--accent-lit); }
  .heroA__row { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; flex-wrap: wrap; margin-top: 48px; }
  .heroA__sub { color: var(--paper); font-size: 15px; letter-spacing: 0.16em; }
  .heroA__cta { display: flex; gap: 14px; flex-wrap: wrap; }

  @media (prefers-reduced-motion: reduce) {
    .heroA__video { display: none; }
    .heroA__media { background: #0C0B0A url("/cdn/hero/hero-a-v3.jpg") center / cover no-repeat; }
  }
</style>
