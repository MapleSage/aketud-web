---
/* Section-page hero — dark band, optional silent video background, grain + scrim.
   Reuses the Hero A visual language at a smaller scale (used on /retail, /insurance…). */
interface Props {
  eyebrow?: string;
  title: string;          // \n allowed
  intro?: string;
  video?: string;         // R2 base name, e.g. "retail" -> /cdn/hero/retail.{webm,mp4,jpg}
}
const { eyebrow, title, intro, video } = Astro.props;
const titleHtml = title.split('\n').join('<br />');
---
<section class:list={['phero', { 'phero--media': !!video }]}>
  {video && (
    <div class="phero__media" aria-hidden="true">
      <video autoplay muted loop playsinline preload="metadata" poster={`/cdn/hero/${video}.jpg`}>
        <source src={`/cdn/hero/${video}.webm`} type="video/webm" />
        <source src={`/cdn/hero/${video}.mp4`} type="video/mp4" />
      </video>
      <div class="phero__scrim"></div>
      <div class="phero__grain"></div>
    </div>
  )}
  <div class="wrap phero__inner">
    {eyebrow && <div class="eyebrow phero__eyebrow">{eyebrow}</div>}
    <h1 class="disp phero__title" set:html={titleHtml}></h1>
    {intro && <p class="phero__intro">{intro}</p>}
  </div>
</section>

<style>
  .phero { position: relative; background: var(--paper); overflow: hidden; padding-block: clamp(72px, 12vw, 130px); }
  .phero--media { background: var(--ink-black); color: var(--paper); }
  .phero__media { position: absolute; inset: 0; }
  .phero__media video { width: 100%; height: 100%; object-fit: cover; }
  .phero__scrim {
    position: absolute; inset: 0;
    background:
      radial-gradient(80% 60% at 82% 10%, rgba(196,83,31,0.24) 0%, rgba(12,11,10,0) 60%),
      linear-gradient(180deg, rgba(12,11,10,0.42) 0%, rgba(12,11,10,0.30) 40%, rgba(12,11,10,0.78) 100%);
  }
  .phero__grain {
    position: absolute; inset: 0; opacity: 0.26; mix-blend-mode: overlay; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='240' height='240' filter='url(%23n)'/></svg>");
  }
  .phero__inner { position: relative; z-index: 2; }
  .phero__eyebrow { color: var(--accent); }
  .phero--media .phero__eyebrow { color: var(--accent-lit); }
  .phero__title { font-size: clamp(2.6rem, 7vw, 5rem); line-height: 0.98; letter-spacing: -0.032em; margin: 22px 0 0; }
  .phero__intro { font-family: var(--disp); font-size: clamp(1.3rem, 2.4vw, 1.9rem); line-height: 1.34; letter-spacing: -0.012em; max-width: 40ch; margin: 28px 0 0; }
  .phero--media .phero__intro { color: rgba(245, 242, 237, 0.9); }

  @media (prefers-reduced-motion: reduce) {
    .phero__media video { display: none; }
    .phero--media .phero__media { background: #0C0B0A center / cover no-repeat; }
  }
</style>
<script>
  // reduced-motion: swap in the poster as a background
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.phero--media .phero__media').forEach((m) => {
      const v = m.querySelector('video');
      if (v?.poster) m.style.backgroundImage = `url(${v.poster})`;
    });
  }
</script>
